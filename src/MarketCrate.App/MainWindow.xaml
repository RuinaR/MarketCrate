<Window x:Class="MarketCrate.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:MarketCrate.App.Controls" c:Motion.Reduced="{Binding ReducedMotion}" Title="MarketCrate · Mock workspace" Width="1380" Height="860" MinWidth="1100" MinHeight="700" ShowActivated="False" Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI, Malgun Gothic" FontSize="13" ToolTipService.InitialShowDelay="650">
  <Window.Resources>
    <DataTemplate x:Key="Row">
      <Grid Margin="2,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="38" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="95" />
          <ColumnDefinition Width="95" />
          <ColumnDefinition Width="128" />
        </Grid.ColumnDefinitions>
        <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="{Binding Name}" />
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Game}" Style="{StaticResource MutedText}" />
          <TextBlock Text="{Binding Flags}" Style="{StaticResource MutedText}" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Average}" VerticalAlignment="Center" ToolTip="24시간 거래량 가중 평균 · Mock" />
        <TextBlock Grid.Column="3" Text="{Binding Bid}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" ToolTip="최상위 구매주문 · 수량별 가격은 최종 검토에서 분리" />
        <StackPanel Grid.Column="4">
          <c:NumericStepper Value="{Binding Quantity}" Maximum="{Binding Maximum}" IsEnabled="{Binding CanSelect}" />
          <TextBlock Text="{Binding Maximum,StringFormat=보유 {0}개}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="Card">
      <Border Width="234" Style="{StaticResource PanelStyle}" Margin="4">
        <StackPanel>
          <Border Background="#263C4A" Height="62" CornerRadius="6" Margin="0,0,0,12">
            <TextBlock Text="◇" FontSize="38" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}" Content="{Binding Name}" AutomationProperties.Name="{Binding Name}" />
          <TextBlock Text="{Binding Game}" Style="{StaticResource MutedText}" />
          <TextBlock Text="{Binding Flags}" Style="{StaticResource MutedText}" Margin="0,5" />
          <Grid Margin="0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="24h 평균" Style="{StaticResource MutedText}" />
              <TextBlock Text="{Binding Average}" FontSize="18" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="최상위 매수" Style="{StaticResource MutedText}" />
              <TextBlock Text="{Binding Bid}" Foreground="{StaticResource Accent}" FontSize="18" />
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal">
            <c:NumericStepper Value="{Binding Quantity}" Maximum="{Binding Maximum}" IsEnabled="{Binding CanSelect}" />
            <TextBlock Text="{Binding Maximum,StringFormat=/ {0}개}" VerticalAlignment="Center" Margin="6,0" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210" />
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="◇ MARKETCRATE" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="INVENTORY / MARKET DESK" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5" />
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="16,0">
        <TextBlock Text="보관함에서, 최종 검토까지." FontSize="22" />
        <TextBlock Text="MOCK WORKSPACE · 합성 데이터 · 실제 Steam 계정 연결 없음" Style="{StaticResource MutedText}" />
      </StackPanel>
      <Button Grid.Column="2" Content="Mock 데이터 갱신" Command="{Binding Refresh}" />
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="190" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="270" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource PanelStyle}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="실등록 연동 차단" Foreground="{StaticResource Warning}" FontWeight="Bold" />
            <TextBlock Text="Valve 허용 경로 확인 및 명시적 활성화가 필요합니다. 제재 위험 0을 보장하지 않습니다." Style="{StaticResource MutedText}" Margin="0,8" />
            <TextBlock Text="자동 갱신 OFF · 네트워크 OFF" Style="{StaticResource MutedText}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="LIBRARY" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
            <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" MinHeight="170" AutomationProperties.Name="게임 선택" />
            <TextBlock Text="안전한 데모" Foreground="{StaticResource Accent}" Margin="0,24,0,8" />
            <TextBlock Text="비밀번호·쿠키·Steam Guard 비밀을 입력하지 않습니다." Style="{StaticResource MutedText}" />
          </StackPanel>
        </DockPanel>
      </Border>
      <TabControl Grid.Column="2" x:Name="WorkspaceTabs" AutomationProperties.Name="작업 화면">
        <TabItem Header="보관함">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="150" />
              </Grid.ColumnDefinitions>
              <TextBox Style="{StaticResource SearchBox}" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort}" AutomationProperties.Name="정렬" />
            </Grid>
            <WrapPanel Grid.Row="1" Margin="0,10">
              <CheckBox Content="판매 가능만" IsChecked="{Binding MarketableOnly}" />
              <Button Content="현재 게임 전체 선택" Command="{Binding SelectAll}" />
              <Button Content="선택 해제" Command="{Binding ClearSelection}" />
              <ToggleButton Content="카드 보기" IsChecked="{Binding GridMode}" ToolTip="해제하면 가상화된 목록 보기" />
            </WrapPanel>
            <ListBox Grid.Row="2" ItemsSource="{Binding VisibleItems}" AutomationProperties.Name="Mock 보관함" x:Name="InventoryList">
              <ListBox.Style>
                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                  <Setter Property="ItemTemplate" Value="{StaticResource Row}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding GridMode}" Value="True">
                      <Setter Property="ItemTemplate" Value="{StaticResource Card}" />
                      <Setter Property="ItemsPanel">
                        <Setter.Value>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </Setter.Value>
                      </Setter>
                      <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ListBox.Style>
            </ListBox>
            <TextBlock Grid.Row="2" Text="조건에 맞는 아이템이 없습니다." HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoItems,Converter={StaticResource BoolVisibility}}" />
            <TextBlock Grid.Row="3" Text="가격은 구매자 지불액 · 합성 KRW · 24시간 VWAP / 구매주문 잔량은 별개 · 체결 보장 없음" Style="{StaticResource MutedText}" Margin="4,10" />
          </Grid>
        </TabItem>
        <TabItem Header="판매 중">
          <StackPanel>
            <TextBlock Text="판매 현황 / Mock" Style="{StaticResource Heading}" />
            <Border Style="{StaticResource PanelStyle}">
              <StackPanel>
                <TextBlock Text="Prism Collection · 1개 × ₩1,200" FontSize="17" />
                <TextBlock Text="Mock Listed · 비교 평균 ₩1,270 · 실제 게시 내역 아님" Margin="0,8" />
                <TextBlock Text="Moonlit Archive · Mock 승인 대기 · 게시 전" Foreground="{StaticResource Warning}" />
                <WrapPanel Margin="0,12">
                  <Button Content="판매 취소 검토" Command="{Binding CancelPlan}" />
                  <Button Content="가격 변경 검토" Command="{Binding CancelPlan}" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </TabItem>
        <TabItem Header="배치 결과">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding ProgressSummary}" FontSize="17" Margin="0,8" />
            <TextBlock Grid.Row="1" Text="승인 대기 ≠ 게시 완료. 실연동 시 공식 Steam 모바일 앱에서 직접 승인 후 서버 대조가 필요합니다. 이 데모는 자동 승인하지 않습니다." Foreground="{StaticResource Warning}" Margin="0,8,0,16" />
            <ListBox Grid.Row="2" ItemsSource="{Binding Results}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="4,8">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="3">
              <Button Content="저널 복구 / Mock 상태 대조" Command="{Binding Recover}" />
              <Button Content="합성 Mock 기록 삭제 / 새 배치" Command="{Binding ClearDemo}" ToolTip="실제 계정 데이터가 아닌 데모 저널만 삭제" />
            </StackPanel>
          </Grid>
        </TabItem>
        <TabItem Header="기록·안전">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="투명한 기능 상태" Style="{StaticResource Heading}" />
              <TextBlock Text="Available: 로컬 계산 / Mock: 보관함·시세·배치 / Unavailable: 실제 읽기 / Blocked: 실제 등록·취소·재등록" Margin="0,8" />
              <TextBlock Text="최종 제품 목표: 최종 검토의 단 한 번 승인으로 선택 전체 실제 Steam 장터 등록. 현재 Mock은 실판매 완성이 아닙니다." Foreground="{StaticResource Warning}" Margin="0,8" />
              <CheckBox Content="모션 축소 (기본 ON, 현재 정적 상태 사용)" IsChecked="{Binding ReducedMotion}" />
              <TextBlock Text="백그라운드 폴링·자동 시작·타 앱 입력·프로세스 조사 없음. 수수료는 Demo 정책 추정이며 실제 Steam 통화별 산식은 미검증입니다." Margin="0,12" />
              <ItemsControl ItemsSource="{Binding History}" />
              <TextBlock Text="실제 GUI 실행·DPI·접근성 검증은 별도 승인 전 미검증입니다." Style="{StaticResource MutedText}" Margin="0,16" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
      <Border Grid.Column="4" Style="{StaticResource PanelStyle}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Button x:Name="ReviewButton" Content="선택 가격 검토" Command="{Binding Review}" Style="{StaticResource Primary}" />
            <TextBlock Text="이 버튼은 검토만 엽니다. 마지막 Mock 승인 1회로 배치 전체를 처리합니다." Style="{StaticResource MutedText}" Margin="0,10" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="SALE PLAN" Style="{StaticResource MutedText}" />
            <TextBlock Text="{Binding SelectionSummary}" FontSize="19" Margin="0,12" />
            <TextBlock Text="가격 산정 방식" Margin="0,12,0,4" />
            <ComboBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedStrategy}" AutomationProperties.Name="가격 전략" />
            <TextBlock Text="구매자 지불 예상 합계" Style="{StaticResource MutedText}" Margin="0,24,0,8" />
            <TextBlock Text="{Binding Estimate}" FontSize="29" Foreground="{StaticResource Accent}" />
            <TextBlock Text="수수료·실수령·가격별 수량은 최종 검토에서 확인합니다." Style="{StaticResource MutedText}" Margin="0,12" />
            <Border Height="1" Background="{StaticResource Edge}" Margin="0,14" />
            <TextBlock Text="호가 ≠ 체결 확약" FontWeight="SemiBold" />
            <TextBlock Text="매수 주문 잔량에 따라 동일 품목을 가격별로 나눕니다. 부족한 수량은 자동 가격 생성하지 않습니다." Style="{StaticResource MutedText}" Margin="0,8" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource Toast}" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite">
      <TextBlock Text="{Binding Status}" Foreground="{StaticResource Warning}" />
    </Border>
    <Grid Grid.RowSpan="3" Background="#C00A0E16" Visibility="{Binding IsReviewOpen,Converter={StaticResource BoolVisibility}}" x:Name="ReviewOverlay" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="ReviewKeyDown">
      <Border Style="{StaticResource Dialog}" Margin="30" MaxWidth="1100" AutomationProperties.Name="최종 Mock 가격 검토">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="최종 검토 / MOCK BATCH" Style="{StaticResource Heading}" />
            <TextBlock Text="{Binding ReviewTotals}" FontSize="17" Foreground="{StaticResource Accent}" />
            <TextBlock Text="수수료 Demo 정책: 판매자 수령 기준 Steam 5% + 게임 10%, 각 최소 1원 · 정수 절사 · 실제 Steam 산식 미검증" Style="{StaticResource MutedText}" Margin="0,8" />
          </StackPanel>
          <TextBlock Grid.Row="1" Text="자산 · 시세 시각/원천  |  수량 × 구매자 지불 단가(편집)  |  총 수수료 / 실수령" Style="{StaticResource MutedText}" Margin="0,12" />
          <ListBox Grid.Row="2" ItemsSource="{Binding ReviewLines}" x:Name="ReviewList">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1" Padding="0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="50" />
                      <ColumnDefinition Width="125" />
                      <ColumnDefinition Width="100" />
                      <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Identity}" Style="{StaticResource MutedText}" />
                      <TextBlock Text="{Binding CapturedAt,StringFormat=시세 {0:MM-dd HH:mm:ss zzz}}" Style="{StaticResource MutedText}" />
                      <TextBlock Text="{Binding Source}" Style="{StaticResource MutedText}" />
                      <TextBlock Text="{Binding SuggestedPrice,StringFormat=추천 단가 ₩{0:N0}}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Quantity,StringFormat={}{0}개}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="2" Text="{Binding Price,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" AutomationProperties.Name="구매자 지불 단가" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Fee}" VerticalAlignment="Center" Margin="10,0" />
                    <TextBlock Grid.Column="4" Text="{Binding Net}" VerticalAlignment="Center" Foreground="{StaticResource Accent}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="3" Text="실등록 IntegrationBlocked · Mock 결과는 Steam에 게시되지 않습니다. 시세 5분 초과 시 갱신 필요. 승인 대기·불명 상태는 게시 완료가 아닙니다." Foreground="{StaticResource Warning}" Margin="0,14" />
          <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="돌아가기 (Esc)" Command="{Binding CloseReview}" />
            <Button Content="Mock 배치 전체 실행" Command="{Binding Submit}" Style="{StaticResource Primary}" Click="SubmitClicked" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.RowSpan="3" Background="#EA151C29" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}" Padding="40" MaxWidth="480" MaxHeight="260" VerticalAlignment="Center">
      <StackPanel>
        <ContentControl Content="처리 중" ContentTemplate="{StaticResource LoadingSkeleton}" />
        <Button Content="미전송 항목 중단 요청" Command="{Binding Cancel}" />
        <TextBlock Text="이미 접수된 요청은 되돌리지 않습니다." Style="{StaticResource MutedText}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>