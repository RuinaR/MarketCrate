<UserControl x:Class="MarketCrate.App.ProductionShellView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:MarketCrate.App.Controls" xmlns:local="clr-namespace:MarketCrate.App" c:Motion.Reduced="{Binding ReducedMotion}" c:FocusCue.Enabled="True" Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI, Malgun Gothic" FontSize="13">
  <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MarketCrate" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Steam 계정 보관함 · 장터 관리" Style="{StaticResource MutedText}"/></StackPanel><CheckBox Grid.Column="1" Content="움직임 줄이기" IsChecked="{Binding ReducedMotion}" VerticalAlignment="Center"/><Button Grid.Column="2" Content="{Binding DiagnosticsButtonText}" Command="{Binding ShowDiagnostics}"/></Grid>
    <Grid Grid.Row="1"><Border Visibility="{Binding ShowSteam,Converter={StaticResource BoolVisibility}}"><local:SteamWorkspaceView DataContext="{Binding Steam}"/></Border><Border Visibility="{Binding DiagnosticsOpen,Converter={StaticResource BoolVisibility}}"><local:DiagnosticsView DataContext="{Binding Diagnostics}"/></Border></Grid>
  </Grid>
</UserControl>
