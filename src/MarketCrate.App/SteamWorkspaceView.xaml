        <TabItem Header="{Binding InventoryHeader}" Tag="{StaticResource IconInventory}"><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding GameSidebarWidth}"/><ColumnDefinition Width="{Binding GameSidebarGap}"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
