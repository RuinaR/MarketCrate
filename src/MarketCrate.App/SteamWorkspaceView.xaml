<UserControl x:Class="MarketCrate.App.SteamWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:MarketCrate.Core;assembly=MarketCrate.Core" xmlns:c="clr-namespace:MarketCrate.App.Controls" c:FocusCue.Enabled="True" Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI, Malgun Gothic" FontSize="13">
  <UserControl.InputBindings><KeyBinding Key="Escape" Command="{Binding CloseReview}" /></UserControl.InputBindings>
  <UserControl.Resources>
    <c:SaleStateLabelConverter x:Key="SaleStateLabel"/>
    <Style x:Key="SaleStatus" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="AwaitingSteamGuard"><Setter Property="Foreground" Value="{StaticResource Warning}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Unknown"><Setter Property="Foreground" Value="{StaticResource Warning}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Foreground" Value="{StaticResource Error}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Listed"><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style>
    <DataTemplate x:Key="GameRow"><StackPanel Margin="4,6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding StateText}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding MarketableItems,StringFormat=판매 가능 {0}종,TargetNullValue=판매 가능 수 미조회}" Style="{StaticResource MutedText}"/></StackPanel></DataTemplate>
    <DataTemplate x:Key="AssetRow"><Grid Margin="4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
      <c:ItemThumbnail Reference="{Binding Image}" OperationId="{Binding ImageOperation}" Loader="{Binding DataContext.ImageLoader,RelativeSource={RelativeSource AncestorType=UserControl}}" Width="64" Height="64"/>
      <StackPanel Grid.Column="1" Margin="8,0,12,0"><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Flags}"><CheckBox.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate></CheckBox.ContentTemplate></CheckBox><TextBlock Text="{Binding Flags}" Style="{StaticResource MutedText}" Margin="6,4,0,0"/><TextBlock Text="{Binding PriceText}" Style="{StaticResource MutedText}" Margin="6,4,0,0"/></StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="판매 수량" Style="{StaticResource MutedText}" Margin="4,0,0,4"/><c:NumericStepper Value="{Binding Quantity}" Maximum="{Binding Maximum}" IsEnabled="{Binding CanSelect}" Height="36"/></StackPanel>
    </Grid></DataTemplate>
    <DataTemplate x:Key="ListingRow"><Grid Margin="4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
      <c:ItemThumbnail Reference="{Binding Image}" OperationId="{Binding ImageOperation}" Loader="{Binding DataContext.ImageLoader,RelativeSource={RelativeSource AncestorType=UserControl}}" Width="64" Height="64"/>
      <StackPanel Grid.Column="1" Margin="8,0,16,0"><CheckBox Content="{Binding Listing.HashName}" IsChecked="{Binding Selected}"><CheckBox.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate></CheckBox.ContentTemplate></CheckBox><TextBlock Text="{Binding PriceSummary}" Style="{StaticResource MutedText}" Margin="6,4,0,0"/><TextBlock Text="{Binding Metric}" Style="{StaticResource MutedText}" Margin="6,4,0,0"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="변경할 구매자 단가" Style="{StaticResource MutedText}"/><TextBox Text="{Binding NewPriceText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="변경할 구매자 단가, 지갑 통화"/></StackPanel>
    </Grid></DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid x:Name="SteamBody" IsEnabled="{Binding AnyReview,Converter={StaticResource InverseBool}}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{StaticResource Panel}" Padding="16,12" CornerRadius="8" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ConnectionSummary}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Accent}" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding ModeText}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="공식 Steam 장터에서 직접 판매·관리" Command="{Binding OpenOfficialMarket}" ToolTip="공식 페이지를 사용자가 직접 조작합니다. 앱 일괄 등록 완료를 뜻하지 않습니다."/></Grid></Border>
      <TabControl x:Name="SteamPages" Grid.Row="1" SelectedIndex="{Binding WorkPage,Mode=TwoWay}">
        <TabItem Header="계정 연결"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0">
          <TextBlock Text="Steam 계정 연결" Style="{StaticResource Heading}"/><TextBlock Text="{Binding AuthenticationText}" Foreground="{StaticResource Accent}" FontSize="18" Margin="0,0,0,16"/>
          <TextBlock Text="비공식 읽기 연동입니다. 로그인은 사용자가 공식 모바일 앱에서 직접 승인하며 인증정보는 디스크에 저장하지 않습니다." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
          <CheckBox Content="비공식 연동의 계정 제재 위험을 확인했습니다" IsChecked="{Binding RiskAccepted}"/><CheckBox Content="메모리 세션 사용과 인증 보안 위험을 확인했습니다" IsChecked="{Binding CredentialsAccepted}"/>
          <Grid Margin="0,16,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="QR 로그인 시작 / 갱신" Command="{Binding BeginLogin}" Style="{StaticResource Primary}" ToolTip="위험 안내에 동의한 뒤 직접 시작합니다. 연결된 계정은 먼저 로그아웃하세요."/><Button Grid.Column="1" Content="모바일 승인 상태 확인" Command="{Binding CheckLogin}" ToolTip="QR을 공식 모바일 앱에서 승인한 뒤 직접 확인하세요."/><Button Grid.Column="2" Content="취소 / 로그아웃" Command="{Binding Logout}"/></Grid>
          <TextBlock Text="기존 브라우저 로그인은 공식 장터에서 직접 사용할 수 있습니다. 앱으로 세션을 전달하는 공식 경로는 확인되지 않아 독립 QR을 사용합니다. OpenID 신원 확인은 장터 권한이 아닙니다." Style="{StaticResource MutedText}" Margin="0,0,0,8"/><Button Content="읽기 전용 자가검증 화면" Command="{Binding ShowSelfCheck}" HorizontalAlignment="Left"/>
          <TextBlock Text="조회 기능별 상태" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="인증 상태와 각 조회 결과는 별개입니다. 실패한 조회가 다른 기능의 인증을 취소하지 않습니다." Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
          <ItemsControl ItemsSource="{Binding ReadStatuses}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1" Padding="8,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="{StaticResource Muted}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="{Binding RequestAccessText}" Foreground="{StaticResource Warning}" Margin="0,16,0,8"/><TextBlock Text="실제 거래는 기본 비활성화되어 있습니다. 상세 계약과 진단 정보는 고급 설정에서 확인하세요." Style="{StaticResource MutedText}"/>
        </StackPanel><Border Grid.Column="1" Style="{StaticResource PanelStyle}" VerticalAlignment="Top"><StackPanel><TextBlock Text="공식 모바일 앱으로 스캔" FontWeight="SemiBold" Margin="0,0,0,16"/><Grid Height="220"><c:QrCodeView Matrix="{Binding QrMatrix}" Width="220" Height="220" AutomationProperties.Name="Steam 로그인 QR, 공식 모바일 앱으로 스캔"><c:QrCodeView.Style><Style TargetType="c:QrCodeView"><Style.Triggers><DataTrigger Binding="{Binding Connected}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></c:QrCodeView.Style></c:QrCodeView><Border Background="#18322E" CornerRadius="8" Padding="16" Visibility="{Binding Connected,Converter={StaticResource BoolVisibility}}"><StackPanel VerticalAlignment="Center"><TextBlock Text="✓" FontSize="40" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/><TextBlock Text="Steam 인증 완료" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,8"/><TextBlock Text="보관함 또는 판매 중 화면에서 직접 조회하세요." Style="{StaticResource MutedText}" TextAlignment="Center"/></StackPanel></Border></Grid><TextBlock Text="QR 생성은 로그인 완료가 아닙니다. 모바일 승인 후 상태 확인을 눌러 주세요." Style="{StaticResource MutedText}" Margin="0,16,0,0"/></StackPanel></Border></Grid></ScrollViewer></TabItem>
        <TabItem Header="보관함"><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource PanelStyle}" Padding="8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="게임" FontSize="16" FontWeight="SemiBold" Margin="8,8,8,12"/><TextBlock DockPanel.Dock="Bottom" Text="게임 추가·context 관리는 고급 설정에서 할 수 있습니다." Style="{StaticResource MutedText}" Margin="8"/><ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding Game}" ItemTemplate="{StaticResource GameRow}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/></DockPanel></Border>
          <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Game.Name}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding InventoryRead.Summary}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="보관함 갱신" Command="{Binding Load}" ToolTip="{Binding RequestAccessText}"/></Grid>
            <TextBox Grid.Row="1" Style="{StaticResource SearchBox}" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
            <Grid Grid.Row="2" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><CheckBox Content="판매 가능만" IsChecked="{Binding MarketableOnly}"/><CheckBox Content="이름 역순" IsChecked="{Binding Descending}"/></StackPanel><Button Grid.Column="1" Content="전체 선택" Command="{Binding SelectAll}"/><Button Grid.Column="2" Content="선택 해제" Command="{Binding ClearSelection}"/></Grid>
            <Grid Grid.Row="3"><ListBox x:Name="InventoryList" c:ScrollMemory.Key="{Binding Game.Key}" ItemsSource="{Binding VisibleAssets}" ItemTemplate="{StaticResource AssetRow}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><Border Background="{StaticResource Panel}" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding EmptyAssets,Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="표시할 아이템이 없습니다" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="계정 연결 후 갱신하거나 검색·필터를 확인하세요." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border></Grid>
          </Grid>
          <Border Grid.Column="4" Style="{StaticResource PanelStyle}"><DockPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{Binding SelectionEstimate}" Style="{StaticResource MutedText}" Margin="0,16,0,8"/><Button Content="최종 가격 검토" Command="{Binding Review}" Style="{StaticResource Primary}" ToolTip="항목 선택·시세·지갑 수수료 조회가 필요합니다."/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="판매 계획" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectionSummary}" Foreground="{StaticResource Accent}" Margin="0,8,0,24"/><TextBlock Text="판매 가격 기준" Style="{StaticResource MutedText}"/><ComboBox ItemsSource="{Binding PricingModes}" SelectedIndex="{Binding PricingMode}" ToolTip="{x:Static core:PriceDisplay.ImmediateExplanation}" AutomationProperties.Name="판매 가격 기준"/><ComboBox ItemsSource="{Binding PriceWindows}" SelectedIndex="{Binding WindowIndex}" AutomationProperties.Name="중앙값 추정 기준 기간"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding PricingMode}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox><TextBlock Text="{x:Static core:PriceDisplay.ImmediateExplanation}" Style="{StaticResource MutedText}" Margin="0,8,0,16"/><Button Content="선택 시세 갱신" Command="{Binding RefreshPrices}" ToolTip="{Binding RequestAccessText}"/><Button Content="지갑·수수료만 조회" Command="{Binding LoadFees}" ToolTip="{Binding RequestAccessText}"/><TextBlock Text="{Binding CurrencyText}" Style="{StaticResource MutedText}" Margin="0,12,0,0"/></StackPanel></ScrollViewer></DockPanel></Border>
        </Grid></TabItem>
        <TabItem Header="판매 중"><Grid Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="현재 판매 중" Style="{StaticResource Heading}"/><TextBlock Text="{Binding ListingsRead.Summary}" Style="{StaticResource MutedText}"/></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding Games}" SelectedItem="{Binding Game}" AutomationProperties.Name="판매목록 게임 필터"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Grid.Column="2" Content="판매목록만 조회" Command="{Binding LoadListings}" ToolTip="{Binding RequestAccessText}"/></Grid>
          <Grid Grid.Row="1" Margin="0,8,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Style="{StaticResource SearchBox}" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="판매목록 전체 선택" Command="{Binding SelectAllListings}"/><Button Grid.Column="2" Content="선택 해제" Command="{Binding ClearListings}"/><Button Grid.Column="3" Content="선택 취소 검토" Command="{Binding ReviewCancel}" Foreground="{StaticResource Error}"/><Button Grid.Column="4" Content="가격 변경 검토" Command="{Binding ReviewReprice}"/></Grid>
          <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Game.Name}" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="선택 판매 가격 지표 조회" Command="{Binding ListingMetrics}"/></Grid><ListBox Grid.Row="1" c:ScrollMemory.Key="{Binding Game.Key}" ItemsSource="{Binding VisibleListings}" ItemTemplate="{StaticResource ListingRow}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><TextBlock Grid.Row="1" Text="판매목록을 조회하거나 게임·검색 조건을 확인하세요." Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding EmptyListings,Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False"/></Grid>
        </Grid></TabItem>
        <TabItem Header="결과 · 작업 이력"><Grid Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="판매 결과 및 작업 이력" Style="{StaticResource Heading}"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Requests}" SelectedItem="{Binding SelectedRequest}" AutomationProperties.Name="대조할 요청"/><Button Grid.Column="1" Content="증거 대조" Command="{Binding Inspect}"/><Button Grid.Column="2" Content="상태 재조회" Command="{Binding Recover}"/></Grid><ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="{Binding EvidenceText}" Margin="0,16"/><ItemsControl ItemsSource="{Binding Results}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource PanelStyle}" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding State,Converter={StaticResource SaleStateLabel}}" Style="{StaticResource SaleStatus}"/><TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="확정 배치 보관" Command="{Binding ArchiveBatch}" HorizontalAlignment="Left"/><TextBlock Text="승인 대기와 결과 불명은 완료가 아닙니다. 불명 요청은 자동 재전송하지 않습니다." Foreground="{StaticResource Warning}" Margin="0,16"/></StackPanel></ScrollViewer></Grid></TabItem>
        <TabItem Header="고급 설정"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,8,0,0"><TextBlock Text="게임 및 보관함 경로 관리" Style="{StaticResource Heading}"/><TextBlock Text="전체 게임 자동 발견은 지원하지 않습니다. 확인한 AppID와 context만 직접 추가하세요." Style="{StaticResource MutedText}" Margin="0,0,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="AppID"/><TextBox Text="{Binding AppInput,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="추가 AppID"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="context"/><TextBox Text="{Binding ContextInput,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="추가 context ID"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="게임 이름"/><TextBox Text="{Binding NameInput,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="게임 이름"/></StackPanel><Button Grid.Column="3" Content="게임/context 추가" Command="{Binding AddScope}"/><Button Grid.Column="4" Content="현재 목록 제거" Command="{Binding RemoveScope}"/></Grid><TextBlock Text="{Binding ScopeSummary}" Style="{StaticResource MutedText}" Margin="0,8,0,24"/>
          <CheckBox Content="표시된 항목 이미지 로딩 허용 (인증과 분리된 Steam CDN, 끄면 취소)" IsChecked="{Binding ImagesEnabled}"/><TextBlock Text="진단 및 계약 정보" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,8"/><TextBlock Text="{Binding ContractSummary}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding LastOperationId,StringFormat=진단 작업 ID: {0}}" Style="{StaticResource MutedText}" Margin="0,8"/><TextBlock Text="상위 ‘진단 / 로그’에서 해당 작업의 오류 검색과 검토 ZIP 내보내기를 사용하세요." Style="{StaticResource MutedText}"/><TextBlock Text="{Binding ProductReadiness}" Style="{StaticResource MutedText}" Margin="0,8"/>
          <TextBlock Text="실제 거래 활성화 조건" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,8"/><TextBlock Text="{Binding TradingText}" Foreground="{StaticResource Warning}"/><CheckBox Content="비공식 거래의 계정 제재 위험과 실제 거래 발생을 이해하며 이번 세션에 동의" IsChecked="{Binding TradeAccepted}"/><TextBlock Text="선택 게임의 서버 계약을 읽기로 확인합니다. 같은 게임의 기존 판매등록 수수료 증거가 없으면 활성화할 수 없습니다. 스택·중앙값 가격 제출은 별도 차단합니다." Style="{StaticResource MutedText}"/><TextBlock Text="이번 세션 활성화를 원하면 아래에 실제 거래를 입력하세요." Style="{StaticResource MutedText}"/><TextBox Width="320" Text="{Binding TradingConfirmation,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="실제 거래 입력 확인" ToolTip="이 실행에서만 사용할 경우 실제 거래를 입력하세요." MaxWidth="360" HorizontalAlignment="Left"/><Button Content="계약 확인 후 이번 세션 실제 거래 활성화" Command="{Binding PrepareTrading}" HorizontalAlignment="Left"/><TextBlock Text="{Binding TradingPreparation}" Foreground="{StaticResource Warning}"/><Button Content="개발용 합성 계약 활성화 (실제 연결에서는 사용 불가)" Command="{Binding EnableTrading}" Visibility="{Binding ContractToolsVisible,Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" ToolTip="허용 근거와 거래 계약 검증이 없는 빌드에서는 활성화할 수 없습니다."/>
          <TextBlock Text="미확정 취소 · 재가격 대조" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding RepriceKeys}" SelectedItem="{Binding SelectedReprice}" AutomationProperties.Name="보존된 재가격 의도"/><Button Grid.Column="1" Content="재가격 대조·재개" Command="{Binding ResumeReprice}"/><TextBox Grid.Column="2" Text="{Binding RevisedPrice,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="반환 확정 후 새 승인할 구매자 단가"/><Button Grid.Column="3" Content="반환 확정 건 새 가격 검토" Command="{Binding ReviewStoredReprice}"/></Grid><Button Content="선택 품목 중간가격 이력" Command="{Binding MedianHistory}" HorizontalAlignment="Left"/><TextBlock Text="{Binding HistoryText}" Style="{StaticResource MutedText}" Margin="0,8"/>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="연결 자가검증"><Grid Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
