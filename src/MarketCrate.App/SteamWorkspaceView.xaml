                <ListBox Grid.Row="3" c:ScrollMemory.Key="{Binding Game.Key}" ItemsSource="{Binding VisibleListings}" ItemTemplate="{StaticResource ListingRow}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                <Border Grid.Row="3" Visibility="{Binding EmptyListings,Converter={StaticResource BoolVisibility}}" Background="{StaticResource Panel}" CornerRadius="8" IsHitTestVisible="False"><StackPanel Margin="24" VerticalAlignment="Center"><Image Source="{StaticResource IconListings}" Width="32" Height="32" Margin="0,0,0,16"/><TextBlock Text="표시할 판매 항목이 없습니다" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="목록을 갱신하거나 검색어를 확인하세요." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border>
              </Grid>
              <Border Grid.Column="2" Style="{StaticResource PanelStyle}"><ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="선택 항목 관리" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,20"/><TextBlock Text="재등록 가격 기준" Style="{StaticResource MutedText}"/><ComboBox ItemsSource="{Binding PriceTargets}" SelectedIndex="{Binding PriceTarget}" IsEnabled="{Binding CanChoosePriceAdjustment}" Margin="0,8,0,8" AutomationProperties.Name="판매 중 일괄 재등록 가격 기준" ToolTip="{Binding PriceTargetExplanation}"/><CheckBox Content="한 단계 낮게" IsChecked="{Binding LowerPriceOneStep}" IsEnabled="{Binding CanChoosePriceAdjustment}" AutomationProperties.Name="{Binding LowerPriceLabel}" ToolTip="{Binding PriceAdjustmentHint}" Margin="0,8,0,16"/>
