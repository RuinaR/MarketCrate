          <ListBox Grid.Row="2" ItemsSource="{Binding CheckRows}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid Margin="4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding State}" Margin="0,4"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding Result.Outcome}" Value="Succeeded"><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger><DataTrigger Binding="{Binding Result.Outcome}" Value="Failed"><Setter Property="Foreground" Value="{StaticResource Error}"/></DataTrigger><DataTrigger Binding="{Binding Result.Outcome}" Value="Blocked"><Setter Property="Foreground" Value="{StaticResource Warning}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ToggleButton Content="{Binding DetailsLabel}" IsChecked="{Binding ShowDetails,Mode=TwoWay}" FontSize="11" Margin="0,4,8,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Detail}"/><TextBlock Text="{Binding Action}" Style="{StaticResource MutedText}" Margin="0,4"/><StackPanel Visibility="{Binding ShowDetails,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding At}" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Classification}" Style="{StaticResource MutedText}"/><TextBox Text="{Binding Operation,Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="자가검증 작업 ID" ToolTip="고급 설정 또는 진단 / 로그에서 이 작업 ID를 검색하세요."/></StackPanel></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
