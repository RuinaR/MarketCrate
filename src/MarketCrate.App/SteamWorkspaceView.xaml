            <Grid Grid.Row="3"><ListBox x:Name="InventoryList" IsEnabled="{Binding Busy,Converter={StaticResource InverseBool}}" c:ScrollMemory.Key="{Binding Game.Key}" ItemsSource="{Binding VisibleAssets}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}"><Setter Property="ItemTemplate" Value="{StaticResource AssetRow}"/><Style.Triggers><DataTrigger Binding="{Binding GridMode}" Value="True"><Setter Property="ItemTemplate" Value="{StaticResource AssetCard}"/><Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><c:VirtualizingTilePanel/></ItemsPanelTemplate></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></ListBox.Style></ListBox><Border Background="{StaticResource Panel}" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding EmptyAssets,Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="{Binding InventoryEmptyTitle}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding InventoryEmptyHint}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border></Grid>
          </Grid>
          <Border Grid.Column="4" Style="{StaticResource PanelStyle}"><DockPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{Binding SelectionEstimate}" Style="{StaticResource MutedText}" Margin="0,16,0,8"/><Button Content="최종 가격 검토" Command="{Binding Review}" Style="{StaticResource Primary}" ToolTip="항목 선택·시세·지갑 수수료 조회가 필요합니다."/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="판매 계획" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectionSummary}" ToolTip="선택한 TBH 아이템과 수량은 화면을 이동해도 유지됩니다." Foreground="{StaticResource Accent}" Margin="0,8,0,24"/><StackPanel Visibility="{Binding HasPendingInventoryRequests,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,16"><TextBlock Text="{Binding InventorySyncSummary}" Style="{StaticResource MutedText}" Foreground="{StaticResource Warning}"/><Button Content="이전 요청 확인" Command="{Binding OpenPendingInventoryRequests}" Margin="0,8,0,0" ToolTip="이전 요청을 선택해 판매 결과로 이동합니다. 새 등록이나 재전송은 하지 않습니다."/></StackPanel><TextBlock Text="판매 가격 기준" Style="{StaticResource MutedText}"/><ComboBox ItemsSource="{Binding PriceTargets}" SelectedIndex="{Binding PriceTarget}" IsEnabled="{Binding CanChoosePriceAdjustment}" Margin="0,8,0,0" AutomationProperties.Name="판매 가격 기준"/><Expander Header="가격 계산 안내"><StackPanel><TextBlock Text="{Binding PriceTargetExplanation}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding PriceAdjustmentHint}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Expander><CheckBox Content="한 단계 낮게" IsChecked="{Binding LowerPriceOneStep}" IsEnabled="{Binding CanChoosePriceAdjustment}" AutomationProperties.Name="{Binding LowerPriceLabel}" ToolTip="기본은 해제입니다. 수수료·가격 증분을 반영한 다음 유효 가격을 제안하며 체결을 보장하지 않습니다. 최종 검토에서 실수령 감소를 확인하세요." Margin="0,8,0,8"/><Button Content="선택 시세 갱신" Command="{Binding RefreshPrices}" ToolTip="{Binding RequestAccessText}"/><Button Content="지갑 통화만 조회" Visibility="{Binding Mu