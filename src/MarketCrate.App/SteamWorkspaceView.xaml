<UserControl x:Class="MarketCrate.App.SteamWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:MarketCrate.App.Controls" Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI, Malgun Gothic" FontSize="13">
  <UserControl.InputBindings><KeyBinding Key="Escape" Command="{Binding CloseReview}" /></UserControl.InputBindings>
  <Grid>
    <DockPanel IsEnabled="{Binding AnyReview,Converter={StaticResource InverseBool}}">
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8"><TextBlock Text="{Binding ModeText}" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding TradingText}" Style="{StaticResource MutedText}"/></StackPanel>
      <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource MutedText}" Margin="0,8"/>
      <TabControl x:Name="SteamPages">
        <TabItem Header="QR 연결">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"><Border Style="{StaticResource PanelStyle}" Margin="0,0,16,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="직접 시작하는 Steam 로그인" Style="{StaticResource Heading}"/><TextBlock Text="실계정 미검증 빌드 · 로그인/조회도 비공식 경로 · 제한 응답에서 중단" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
                <CheckBox Content="비공식 연동의 계정 제재 위험을 확인했습니다" IsChecked="{Binding RiskAccepted}" />
                <CheckBox Content="메모리 세션 사용과 인증 보안 위험을 확인했습니다" IsChecked="{Binding CredentialsAccepted}" />
                <WrapPanel><Button Content="QR 로그인 시작" Command="{Binding BeginLogin}"/><Button Content="모바일 승인 상태 확인" Command="{Binding CheckLogin}"/><Button Content="취소 / 로그아웃" Command="{Binding Logout}"/></WrapPanel>
                <TextBlock Text="{Binding LoginState}" Foreground="{StaticResource Accent}" Margin="0,8"/>
                <TextBlock Text="Steam 공식 모바일 앱에서 직접 승인하세요. 자동 승인·쿠키 가져오기·비밀번호 입력·토큰 저장은 없습니다. QR은 로컬에서만 생성합니다." Style="{StaticResource MutedText}" Margin="0,8"/>
                <CheckBox Content="정책 근거가 확인된 환경의 거래 활성화에 동의" IsChecked="{Binding TradeAccepted}" />
                <Button Content="검증된 정책 환경에서만 거래 활성화" Command="{Binding EnableTrading}" />
                <TextBlock Text="{Binding TradingText}" Foreground="{StaticResource Warning}" />
              </StackPanel>
              <c:QrCodeView Grid.Column="1" Matrix="{Binding QrMatrix}" Width="220" Height="220" VerticalAlignment="Top" AutomationProperties.Name="Steam 로그인 QR, 공식 모바일 앱으로 스캔" />
            </Grid>
          </Border></ScrollViewer>
        </TabItem>
        <TabItem Header="실제 보관함·호가">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top"><WrapPanel><ComboBox Width="160" ItemsSource="{Binding Games}" SelectedItem="{Binding Game}"/><Button Content="실제 데이터 갱신" Command="{Binding Load}"/><Button Content="전체 선택" Command="{Binding SelectAll}"/><Button Content="선택 해제" Command="{Binding ClearSelection}"/><Button Content="선택 시세 갱신" Command="{Binding RefreshPrices}"/><Button Content="최종 가격 검토" Command="{Binding Review}"/></WrapPanel><WrapPanel><TextBox Width="200" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="아이템 검색"/><CheckBox Content="장터 판매 가능만" IsChecked="{Binding MarketableOnly}"/><CheckBox Content="이름 역순" IsChecked="{Binding Descending}"/></WrapPanel><TextBlock Text="{Binding CurrencyText}" Style="{StaticResource MutedText}"/><TextBlock Text="실제 평균 거래가: 정확한 거래 원자료가 없어 제공하지 않습니다. 호가 추정과 중간가격 이력을 구분합니다." Style="{StaticResource MutedText}"/></StackPanel>
            <Grid><ListBox ItemsSource="{Binding VisibleAssets}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
              <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}"/><TextBlock Text="{Binding Flags}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding PriceText}" Style="{StaticResource MutedText}"/></StackPanel><c:NumericStepper Grid.Column="1" Value="{Binding Quantity}" Maximum="{Binding Maximum}" IsEnabled="{Binding CanSelect}"/></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox><TextBlock Text="표시할 아이템이 없습니다. 연결 후 갱신하거나 검색·필터 조건을 확인하세요." Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding EmptyAssets,Converter={StaticResource BoolVisibility}}"/></Grid>
          </DockPanel>
        </TabItem>
        <TabItem Header="실제 판매·재가격">
          <DockPanel><WrapPanel DockPanel.Dock="Top"><TextBlock Text="현재 선택 게임의 판매목록" VerticalAlignment="Center"/><Button Content="판매목록 전체 선택" Command="{Binding SelectAllListings}"/><Button Content="선택 해제" Command="{Binding ClearListings}"/><Button Content="선택 취소 검토" Command="{Binding ReviewCancel}"/><Button Content="가격 변경 검토" Command="{Binding ReviewReprice}"/><Button Content="상태 재조회" Command="{Binding Recover}"/></WrapPanel><ListBox ItemsSource="{Binding VisibleListings}" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><StackPanel><CheckBox Content="{Binding Description}" IsChecked="{Binding Selected}"/><TextBox Text="{Binding NewPriceText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="변경할 구매자 단가, 지갑 통화" MaxWidth="180" HorizontalAlignment="Left"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
        </TabItem>
        <TabItem Header="결과·수동 대조">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><ComboBox Width="260" ItemsSource="{Binding Requests}" SelectedItem="{Binding SelectedRequest}"/><Button Content="증거 대조" Command="{Binding Inspect}"/><Button Content="선택 품목 중간가격 이력" Command="{Binding MedianHistory}"/><ComboBox Width="180" ItemsSource="{Binding RepriceKeys}" SelectedItem="{Binding SelectedReprice}" AutomationProperties.Name="보존된 재가격 의도"/><Button Content="재가격 대조·재개" Command="{Binding ResumeReprice}"/><TextBox Width="100" Text="{Binding RevisedPrice,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="반환 확정 후 새 승인할 구매자 단가"/><Button Content="반환 확정 건 새 가격 검토" Command="{Binding ReviewStoredReprice}"/><Button Content="확정 배치 보관" Command="{Binding ArchiveBatch}"/></WrapPanel><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="{Binding EvidenceText}" Margin="0,8"/><TextBlock Text="{Binding HistoryText}" Style="{StaticResource MutedText}"/><ItemsControl ItemsSource="{Binding Results}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8"><TextBlock Text="{Binding State}" FontWeight="Bold"/><TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Grid>
        </TabItem>
      </TabControl>
    </DockPanel>
    <Border Background="{StaticResource Canvas}" Padding="20" Visibility="{Binding ReviewOpen,Converter={StaticResource BoolVisibility}}" KeyboardNavigation.TabNavigation="Cycle">
      <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding ModeText}" Foreground="{StaticResource Accent}"/><TextBlock Text="최종 판매 검토 · 구매자 단가 편집" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Totals}"/><TextBlock Text="{Binding TradingText}" Foreground="{StaticResource Warning}"/><TextBlock Text="수동 가격은 현재 검토만 유효 · 승인 대기는 게시 완료 아님 · 부족 수량은 미체결 가능" Style="{StaticResource MutedText}"/></StackPanel><WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right"><Button Content="돌아가기" Command="{Binding CloseReview}"/><Button Content="미전송 중단" Command="{Binding CancelOperation}"/><Button Content="신선도·입력 다시 확인" Command="{Binding RefreshReviewStatus}"/><Button Content="전체 판매등록" Command="{Binding Submit}" Style="{StaticResource Primary}"/></WrapPanel><ListBox ItemsSource="{Binding ReviewRows}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Identity}"/><TextBlock Text="{Binding PriceBasis}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding PriceWarning}" Foreground="{StaticResource Warning}"/><TextBox Text="{Binding PriceText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최종 구매자 단가, KRW 원 또는 USD 달러"/><TextBlock Text="{Binding Amounts}" Style="{StaticResource MutedText}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
    </Border>
    <Border Background="{StaticResource Canvas}" Padding="20" Visibility="{Binding ManagementOpen,Converter={StaticResource BoolVisibility}}" KeyboardNavigation.TabNavigation="Cycle">
      <DockPanel><TextBlock DockPanel.Dock="Top" Text="취소·재가격 최종 검토" Style="{StaticResource Heading}"/><WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right"><Button Content="돌아가기" Command="{Binding CloseReview}"/><Button Content="미전송 중단" Command="{Binding CancelOperation}"/><Button Content="검토한 전체 관리 요청 실행" Command="{Binding ConfirmManagement}"/></WrapPanel><ScrollViewer><StackPanel><TextBlock Text="{Binding ManagementSummary}"/><TextBlock Text="취소 접수·목록 부재·원래 비스택 단일 자산의 동일 ID 반환을 확인한 경우만 재등록. 스택/외부 등록/불명 요청은 추가 증거 없으면 차단." Foreground="{StaticResource Warning}"/></StackPanel></ScrollViewer></DockPanel>
    </Border>
  </Grid>
</UserControl>
