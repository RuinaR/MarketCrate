            </Grid>
            <Expander Grid.Row="4" Header="자료·조회 상세" MaxHeight="180"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding TbhSnapshotText}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding TbhNextAction}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/><TextBlock Text="{Binding TbhSaveSummary}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/><TextBlock Text="{Binding TbhSaveStatus}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/><TextBlock Text="게임 저장본과 Steam 판매 가능 자산은 다릅니다. 실제 판매는 Steam 보관함에서 진행하세요." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></ScrollViewer></Expander>
          </Grid>
