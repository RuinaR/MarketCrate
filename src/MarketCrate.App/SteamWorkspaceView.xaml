<UserControl x:Class="MarketCrate.App.SteamWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:MarketCrate.Core;assembly=MarketCrate.Core" xmlns:c="clr-namespace:MarketCrate.App.Controls" c:FocusCue.Enabled="True" Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI, Malgun Gothic" FontSize="13">
  <UserControl.InputBindings><KeyBinding Key="Escape" Command="{Binding CloseReview}" /></UserControl.InputBindings>
  <UserControl.Resources>
    <c:SaleStateLabelConverter x:Key="SaleStateLabel"/>
    <Style x:Key="SaleStatus" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="AwaitingSteamGuard"><Setter Property="Foreground" Value="{StaticResource Warning}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Unknown"><Setter Property="Foreground" Value="{StaticResource Warning}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Foreground" Value="{StaticResource Error}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Listed"><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style>
    <DataTemplate x:Key="GameRow"><StackPanel Margin="4,6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding StateText}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding MarketableItems,StringFormat=판매 가능 {0}종,TargetNullValue=판매 가능 수 미조회}" Style="{StaticResource MutedText}"/></StackPanel></DataTemplate>
    <DataTemplate x:Key="AssetRow"><Grid Margin="4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
      <c:ItemThumbnail Reference="{Binding Image}" OperationId="{Binding ImageOperation}" Loader="{Binding DataContext.ImageLoader,RelativeSource={RelativeSource AncestorType=UserControl}}" Width="64" Height="64"/>
      <StackPanel Grid.Column="1" Margin="8,0,12,0"><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding SelectionHint}" ToolTipService.ShowOnDisabled="True"><CheckBox.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate></CheckBox.ContentTemplate></CheckBox><TextBlock Text="{Binding Flags}" Style="{StaticResource MutedText}" Margin="6,4,0,0"/><TextBlock Text="{Binding PriceText}" Style="{StaticResource MutedText}" Margin="6,4,0,0"/></StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="판매 수량" Style="{StaticResource MutedText}" Margin="4,0,0,4"/><c:NumericStepper Value="{Binding Quantity}" Maximum="{Binding Maximum}" IsEnabled="{Binding CanSelect}" Height="36"/></StackPanel>
    </Grid></DataTemplate>
    <DataTemplate x:Key="AssetCard"><Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="40"/><RowDefinition Height="46"/><RowDefinition Height="44"/><RowDefinition Height="48"/></Grid.RowDefinitions><c:ItemThumbnail Reference="{Binding Image}" OperationId="{Binding ImageOperation}" Loader="{Binding DataContext.ImageLoader,RelativeSource={RelativeSource AncestorType=UserControl}}" Width="88" Height="88" HorizontalAlignment="Center"/><CheckBox Grid.Row="1" Content="{Binding Name}" IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding SelectionHint}" ToolTipService.ShowOnDisabled="True" VerticalAlignment="Center"><CheckBox.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" MaxHeight="36" TextTrimming="CharacterEllipsis"/></DataTemplate></CheckBox.ContentTemplate></CheckBox><TextBlock Grid.Row="2" Text="{Binding Flags}" Style="{StaticResource MutedText}" MaxHeight="40" ToolTip="{Binding Flags}"/><TextBlock Grid.Row="3" Text="{Binding PriceText}" Style="{StaticResource MutedText}" MaxHeight="40" ToolTip="{Binding PriceText}"/><Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBlock Text="판매 수량" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><c:NumericStepper Grid.Column="1" Value="{Binding Quantity}" Maximum="{Binding Maximum}" IsEnabled="{Binding CanSelect}" Height="36"/></Grid></Grid></DataTemplate>
    <DataTemplate x:Key="ListingRow"><Grid Margin="4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
      <c:ItemThumbnail Reference="{Binding Image}" OperationId="{Binding ImageOperation}" Loader="{Binding DataContext.ImageLoader,RelativeSource={RelativeSource AncestorType=UserControl}}" Width="64" Height="64"/>
      <StackPanel Grid.Column="1" Margin="8,0,16,0"><CheckBox Content="{Binding Listing.HashName}" IsChecked="{Binding Selected}" IsEnabled="{Binding DataContext.Busy,RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource InverseBool}}"><CheckBox.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate></CheckBox.ContentTemplate></CheckBox><TextBlock Text="{Binding PriceSummary}" Style="{StaticResource MutedText}" Margin="6,4,0,0"/><TextBlock Text="{Binding Metric}" Style="{StaticResource MutedText}" Margin="6,4,0,0"/><TextBlock Text="{Binding Proposal}" Style="{StaticResource MutedText}" Margin="6,4,0,0"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="변경할 구매자 단가" Style="{StaticResource MutedText}"/><TextBox IsEnabled="{Binding DataContext.Busy,RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource InverseBool}}" Text="{Binding NewPriceText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="변경할 구매자 단가, 지갑 통화"/></StackPanel>
    </Grid></DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid x:Name="SteamBody" IsEnabled="{Binding AnyReview,Converter={StaticResource InverseBool}}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{StaticResource Panel}" Padding="16,12" CornerRadius="8" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ConnectionSummary}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Accent}" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding ModeText}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="공식 Steam 장터에서 직접 판매·관리" Command="{Binding OpenOfficialMarket}" ToolTip="공식 페이지를 사용자가 직접 조작합니다. 앱 일괄 등록 완료를 뜻하지 않습니다."/></Grid></Border>
      <TabControl x:Name="SteamPages" Grid.Row="1" SelectedIndex="{Binding NavigationIndex,Mode=TwoWay}">

        <TabItem Header="보관함"><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource PanelStyle}" Padding="8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="보관함" FontSize="16" FontWeight="SemiBold" Margin="8,8,8,12"/><Button DockPanel.Dock="Bottom" Content="게임 추가 · 관리" Command="{Binding OpenGameSettings}" Margin="4,8" ToolTip="AppID/context를 직접 관리합니다. 게임 보유 여부를 추정하지 않습니다."/><ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding Game}" ItemTemplate="{StaticResource GameRow}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/></DockPanel></Border>
          <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Game.Name}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding InventoryRead.Summary}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="보관함 갱신" Command="{Binding Load}" ToolTip="{Binding RequestAccessText}"/></Grid>
            <TextBox Grid.Row="1" Style="{StaticResource SearchBox}" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
            <Grid Grid.Row="2" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><CheckBox Content="판매 가능만" IsChecked="{Binding MarketableOnly}"/><CheckBox Content="역순" IsChecked="{Binding Descending}"/><ToggleButton Content="카드" IsChecked="{Binding GridMode}" ToolTip="카드/목록 전환 · 두 보기 모두 가상화합니다." AutomationProperties.Name="보관함 카드 보기 전환"/></StackPanel><Button Grid.Column="1" Content="전체 선택" Command="{Binding SelectAll}"/><Button Grid.Column="2" Content="선택 해제" Command="{Binding ClearSelection}"/></Grid>
            <Grid Grid.Row="3"><ListBox x:Name="InventoryList" IsEnabled="{Binding Busy,Converter={StaticResource InverseBool}}" c:ScrollMemory.Key="{Binding Game.Key}" ItemsSource="{Binding VisibleAssets}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}"><Setter Property="ItemTemplate" Value="{StaticResource AssetRow}"/><Style.Triggers><DataTrigger Binding="{Binding GridMode}" Value="True"><Setter Property="ItemTemplate" Value="{StaticResource AssetCard}"/><Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><c:VirtualizingTilePanel/></ItemsPanelTemplate></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></ListBox.Style></ListBox><Border Background="{StaticResource Panel}" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding EmptyAssets,Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="{Binding InventoryEmptyTitle}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding InventoryEmptyHint}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border></Grid>
          </Grid>
          <Border Grid.Column="4" Style="{StaticResource PanelStyle}"><DockPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{Binding SelectionEstimate}" Style="{StaticResource MutedText}" Margin="0,16,0,8"/><Button Content="최종 가격 검토" Command="{Binding Review}" Style="{StaticResource Primary}" ToolTip="항목 선택·시세·지갑 수수료 조회가 필요합니다."/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="판매 계획" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectionSummary}" ToolTip="다른 게임에서 선택한 항목도 전체 판매 대상에 포함됩니다. 게임 전환과 화면 캐시 정리로 선택을 버리지 않습니다." Foreground="{StaticResource Accent}" Margin="0,8,0,24"/><StackPanel Visibility="{Binding HasPendingInventoryRequests,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,16"><TextBlock Text="{Binding InventorySyncSummary}" Style="{StaticResource MutedText}" Foreground="{StaticResource Warning}"/><Button Content="이전 요청 확인" Command="{Binding OpenPendingInventoryRequests}" Margin="0,8,0,0" ToolTip="이전 요청을 선택해 판매 결과로 이동합니다. 새 등록이나 재전송은 하지 않습니다."/></StackPanel><TextBlock Text="판매 가격 기준" Style="{StaticResource MutedText}"/><TextBlock Text="{x:Static core:PriceDisplay.Immediate}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" AutomationProperties.Name="판매 가격 기준"/><TextBlock Text="{x:Static core:PriceDisplay.ImmediateExplanation}" Style="{StaticResource MutedText}" Margin="0,8,0,16"/><Button Content="선택 시세 갱신" Command="{Binding RefreshPrices}" ToolTip="{Binding RequestAccessText}"/><Button Content="지갑 통화만 조회" Command="{Binding LoadWallet}" ToolTip="판매 수수료 오류와 독립적으로 지갑 통화만 갱신합니다."/><Button Content="지갑·수수료만 조회" Command="{Binding LoadFees}" ToolTip="{Binding RequestAccessText}"/><TextBlock Text="{Binding CurrencyText}" Style="{StaticResource MutedText}" Margin="0,12,0,0"/></StackPanel></ScrollViewer></DockPanel></Border>
        </Grid></TabItem>
        <TabItem Header="판매 중"><Grid Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="현재 판매 중" Style="{StaticResource Heading}"/><TextBlock Text="{Binding ListingsRead.Summary}" Style="{StaticResource MutedText}"/></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding Games}" SelectedItem="{Binding Game}" AutomationProperties.Name="판매목록 게임 필터"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Grid.Column="2" Content="판매목록만 조회" Command="{Binding LoadListings}" ToolTip="{Binding RequestAccessText}"/></Grid>
          <Grid Grid.Row="1" Margin="0,8,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Style="{StaticResource SearchBox}" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="판매목록 전체 선택" Command="{Binding SelectAllListings}"/><Button Grid.Column="2" Content="선택 해제" Command="{Binding ClearListings}"/><Button Grid.Column="3" Content="선택 취소 검토" Command="{Binding ReviewCancel}" Foreground="{StaticResource Error}"/><Button Grid.Column="4" Content="입력 단가로 검토" Command="{Binding ReviewReprice}"/></Grid>
          <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="200"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Game.Name}" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{x:Static core:PriceDisplay.Immediate}" VerticalAlignment="Center" Margin="8,0" AutomationProperties.Name="판매 중 일괄 재등록 가격 기준"/><Button Grid.Column="2" Content="선택 전체 재등록 가격 검토" Command="{Binding PrepareListingReprice}" ToolTip="{Binding ListingPriceStatus}"/><Button Grid.Column="3" Content="시세 비교" Command="{Binding ListingMetrics}"/></Grid>
            <StackPanel Grid.Row="1"><TextBlock Text="{Binding ListingPriceStatus}" Style="{StaticResource MutedText}" Margin="8,8"/><TextBlock Text="{Binding ListingMetadataSummary}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="8,0,8,8"/></StackPanel>
            <Grid Grid.Row="2" Visibility="{Binding HasPendingRelists,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding PendingRelists}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedRelist}" AutomationProperties.Name="취소 후 새 판매 대상을 검토할 작업" ToolTip="작업별 취소 접수 수를 확인하세요. 불명 항목은 자동 재전송하지 않습니다."/><Button Grid.Column="1" Content="취소 후 새 대상 검토" Command="{Binding ReviewCancelledTargets}" ToolTip="선택한 취소 계획의 실제 보관함·가격을 다시 조회합니다. 자동 등록하지 않습니다."/></Grid>
            <ListBox Grid.Row="3" c:ScrollMemory.Key="{Binding Game.Key}" ItemsSource="{Binding VisibleListings}" ItemTemplate="{StaticResource ListingRow}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><TextBlock Grid.Row="3" Text="판매목록을 조회하거나 게임·검색 조건을 확인하세요." Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding EmptyListings,Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False"/>
          </Grid>
        </Grid></TabItem>
        <TabItem Header="판매 결과"><Grid Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel><TextBlock Text="판매 결과 및 작업 이력" Style="{StaticResource Heading}"/><TextBlock Text="{Binding BatchProgressText}" Margin="0,0,0,12" Foreground="{StaticResource Accent}" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding ApprovalHandoffText}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding ListingMetadataSummary}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,0,0,8"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="저장된 요청이 없습니다. 판매 요청 후 상태를 확인할 수 있습니다." Margin="0,8"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RequestOptions.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ComboBox ItemsSource="{Binding RequestOptions}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding SelectedRequest}" AutomationProperties.Name="대조할 요청"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding RequestOptions.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox><Button Content="선택 요청 상태 확인" Command="{Binding RefreshSelectedRequest}" HorizontalAlignment="Left" ToolTip="등록 게시 여부 또는 취소·반환 증거를 다시 조회합니다. 요청을 재전송하지 않습니다."/></StackPanel><Button Grid.Column="1" Content="증거 대조" Command="{Binding Inspect}"/><Button Grid.Column="2" Content="승인 후 게시 확인" Command="{Binding Recover}" ToolTip="사용자가 공식 Steam 앱·이메일에서 승인한 뒤 서버 판매목록을 다시 조회합니다. 승인이나 판매 요청을 전송하지 않습니다."/></Grid><ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="{Binding EvidenceText}" Margin="0,16"/><ItemsControl ItemsSource="{Binding Results}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource PanelStyle}" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding State,Converter={StaticResource SaleStateLabel}}" Style="{StaticResource SaleStatus}"/><TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="종료·미전송 배치 보관" Command="{Binding ArchiveBatch}" ToolTip="게시 확인·확정 실패·미전송만 보관합니다. 승인 대기·처리 중·불명 결과는 먼저 대조해야 하며 기록을 삭제하지 않습니다." HorizontalAlignment="Left"/><TextBlock Text="승인 대기와 결과 불명은 완료가 아닙니다. 불명 요청은 자동 재전송하지 않습니다." Foreground="{StaticResource Warning}" Margin="0,16"/></StackPanel></ScrollViewer></Grid></TabItem>
        <TabItem Header="계정 및 설정"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0">
          <TextBlock Text="Steam 계정 연결" Style="{StaticResource Heading}"/><TextBlock Text="{Binding AuthenticationText}" Foreground="{StaticResource Accent}" FontSize="18" Margin="0,0,0,16"/>
          <TextBlock Text="비공식 읽기 연동입니다. 로그인은 사용자가 공식 모바일 앱에서 직접 승인하며 로그인 유지 선택 시에만 Refresh Token을 이 Windows 사용자 범위로 암호화 저장합니다." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
          <CheckBox Content="비공식 연동의 계정 제재 위험을 확인했습니다" IsChecked="{Binding RiskAccepted}"/><CheckBox Content="앱 자체 세션과 선택적 암호화 저장의 보안 위험을 확인했습니다" IsChecked="{Binding CredentialsAccepted}"/>
          <Border Style="{StaticResource PanelStyle}" Margin="0,16,0,0"><StackPanel><CheckBox Content="로그인 상태 유지 · 다음 실행 시 한 번 자동 복원" IsChecked="{Binding RememberLogin}" IsEnabled="{Binding CanChangeRememberLogin}"/><TextBlock Text="{Binding SavedLoginMessage}" Style="{StaticResource MutedText}" Margin="0,8"/><TextBlock Text="{Binding LastAuthenticationText}" Style="{StaticResource MutedText}"/><Button Content="이 PC의 저장 로그인 삭제" Command="{Binding DeleteSavedLogin}" HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="MarketCrate의 로컬 암호화 자격 증명만 삭제합니다. 서버 토큰 철회는 아니며 거래 저널은 보존합니다."/></StackPanel></Border>
          <Grid Margin="0,16,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="QR 로그인 시작 / 갱신" Command="{Binding BeginLogin}" Style="{StaticResource Primary}" ToolTip="위험 안내에 동의한 뒤 직접 시작합니다. 연결된 계정은 먼저 로그아웃하세요."/><Button Grid.Column="1" Content="모바일 승인 상태 확인" Command="{Binding CheckLogin}" ToolTip="QR을 공식 모바일 앱에서 승인한 뒤 직접 확인하세요."/><Button Grid.Column="2" Content="취소 / 로그아웃" Command="{Binding Logout}"/></Grid>
          <TextBlock Text="기존 브라우저 로그인은 공식 장터에서 직접 사용할 수 있습니다. 앱으로 세션을 전달하는 공식 경로는 확인되지 않아 독립 QR을 사용합니다. OpenID 신원 확인은 장터 권한이 아닙니다." Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
          <TextBlock Text="조회 기능별 상태" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="인증 상태와 각 조회 결과는 별개입니다. 실패한 조회가 다른 기능의 인증을 취소하지 않습니다." Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
          <ItemsControl ItemsSource="{Binding ReadStatuses}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1" Padding="8,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="{StaticResource Muted}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="{Binding RequestAccessText}" Foreground="{StaticResource Warning}" Margin="0,16,0,8"/><TextBlock Text="실제 거래는 기본 비활성화되어 있습니다. 상세 계약과 진단 정보는 고급 설정에서 확인하세요." Style="{StaticResource MutedText}"/>
