    </Border>
    <Border Background="{StaticResource Canvas}" Padding="20" Visibility="{Binding ManagementOpen,Converter={StaticResource BoolVisibility}}" c:ModalNavigation.IsOpen="{Binding ManagementOpen}" FocusManager.IsFocusScope="True" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle">
