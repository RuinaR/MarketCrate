<UserControl x:Class="MarketCrate.App.DevelopmentReadCheckView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="읽기 전용 연결 자가검증" Style="{StaticResource Heading}"/><TextBlock Text="{Binding CheckSummary}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,0,8"/><TextBlock Text="{Binding CheckNextAction}" Style="{StaticResource MutedText}" Margin="0,0,0,8"/><TextBlock Text="{Binding CheckSource}" Foreground="{StaticResource Warning}"/><TextBlock Text="실제 판매·취소·재가격 요청은 보내지 않습니다. 이 검사도 비공식 자동화의 제재 위험을 없애지 않습니다." Style="{StaticResource MutedText}" Margin="0,4,0,12"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CheckScope}" Style="{StaticResource MutedText}" Margin="0,0,16,0"/><ComboBox x:Name="SelfCheckGame" Grid.Column="1" IsEnabled="{Binding Busy,Converter={StaticResource InverseBool}}" ItemsSource="{Binding Games}" SelectedItem="{Binding Game}" AutomationProperties.Name="자가검증할 게임"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
          <Grid x:Name="SelfCheckScopes" IsEnabled="{Binding Busy,Converter={StaticResource InverseBool}}" Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><CheckBox Content="판매목록 첫 페이지" IsChecked="{Binding CheckListings}"/><CheckBox Grid.Column="1" Content="선택 게임 보관함 첫 페이지" IsChecked="{Binding CheckInventory}"/><CheckBox Grid.Column="2" Content="지갑 통화" IsChecked="{Binding CheckWallet}"/><CheckBox Grid.Row="1" Content="서버 수수료 설정 (지갑 필요)" IsChecked="{Binding CheckFees}" IsEnabled="{Binding CheckWallet}"/><CheckBox Grid.Row="1" Grid.Column="1" Content="선택 한 품목의 구매주문" IsChecked="{Binding CheckOrders}"/><CheckBox Grid.Row="1" Grid.Column="2" Content="선택 한 품목의 가격 이력" IsChecked="{Binding CheckHistory}"/><CheckBox Grid.Row="2" Content="선택 한 품목 이미지 (무인증 CDN)" IsChecked="{Binding CheckImage}"/></Grid>
          </StackPanel>
          <Border Grid.Row="1" Background="{StaticResource Panel}" Padding="12" CornerRadius="6" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><CheckBox x:Name="SelfCheckConsent" IsEnabled="{Binding Busy,Converter={StaticResource InverseBool}}" Content="표시된 게임·품목·범위와 위험을 확인했으며 이번 조회를 실행합니다" IsChecked="{Binding CheckApproved}"/><TextBlock Text="{Binding CheckContext}" Style="{StaticResource MutedText}" Margin="4,4,0,0"/></StackPanel><Button Grid.Column="1" Content="읽기 전용 연결 자가검증" Command="{Binding SelfCheck}" Style="{StaticResource Primary}" ToolTip="Steam 인증과 허용 범위 선택·이번 실행 승인이 필요합니다. 서버 제한 중에는 실행할 수 없습니다."/></Grid></Border>
          <ListBox Grid.Row="2" ItemsSource="{Binding CheckRows}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid Margin="4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding State}" Margin="0,4"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding Result.Outcome}" Value="Succeeded"><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger><DataTrigger Binding="{Binding Result.Outcome}" Value="Failed"><Setter Property="Foreground" Value="{StaticResource Error}"/></DataTrigger><DataTrigger Binding="{Binding Result.Outcome}" Value="Blocked"><Setter Property="Foreground" Value="{StaticResource Warning}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ToggleButton Content="{Binding DetailsLabel}" IsChecked="{Binding ShowDetails,Mode=TwoWay}" FontSize="11" Margin="0,4,8,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Detail}"/><TextBlock Text="{Binding Action}" Style="{StaticResource MutedText}" Margin="0,4"/><StackPanel Visibility="{Binding ShowDetails,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding At}" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Classification}" Style="{StaticResource MutedText}"/><TextBox Text="{Binding Operation,Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="자가검증 작업 ID" ToolTip="고급 설정 또는 진단 / 로그에서 이 작업 ID를 검색하세요."/></StackPanel></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
        </Grid>
</UserControl>