<Project>
  <PropertyGroup>
    <Version>0.20.8</Version><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors><Deterministic>true</Deterministic>
    <MarketCrateProduction Condition="'$(MarketCrateProduction)' == '' and '$(Configuration)' == 'Release'">true</MarketCrateProduction>
  </PropertyGroup>
  <Target Name="MarketCrateBuildIdentity" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="InitializeSourceControlInformation"><ItemGroup><AssemblyMetadata Include="GitCommit" Value="$(SourceRevisionId)" /></ItemGroup></Target>
</Project>
