<Project><PropertyGroup><Version>0.14.0</Version><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors><Deterministic>true</Deterministic></PropertyGroup><Target Name="MarketCrateBuildIdentity" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="InitializeSourceControlInformation">
<ItemGroup><AssemblyMetadata Include="GitCommit" Value="$(SourceRevisionId)" /></ItemGroup>
</Target></Project>
